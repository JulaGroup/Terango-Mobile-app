# Backend Configuration
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Replace 192.168.1.100 with your computer's local IP address
# To find your IP:
# Windows: ipconfig (look for IPv4 Address)
# Mac/Linux: ifconfig (look for inet address)

# For production:
# EXPO_PUBLIC_API_URL=https://your-production-api.com

# Google Maps / Places
# Powers place search in the Express delivery flow and the map pin pickers.
# Enable on the key: Places API (legacy autocomplete), Geocoding API,
# Maps SDK for Android and Maps SDK for iOS.
# EXPO_PUBLIC_* is inlined into the JS bundle, so restrict this key in Google
# Cloud by app (package name / bundle id) and by API.
# Without it, search is hidden and the flow falls back to map pin + saved places.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key

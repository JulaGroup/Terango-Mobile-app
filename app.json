{
  "expo": {
    "name": "TeranGO",
    "slug": "terango",
    "version": "1.0.2",
    "orientation": "portrait",
    "backgroundColor": "#ffffff",
    "icon": "./assets/App-Icon.png",
    "userInterfaceStyle": "light",
    "scheme": ["teranggo"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darboedev.terango",
      "associatedDomains": [
        "applinks:terango.gm",
        "applinks:monkfish-app-korrv.ondigitalocean.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow TeranGO to use your location to find nearby vendors and provide accurate delivery estimates.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow TeranGO to use your location to find nearby vendors and provide accurate delivery estimates.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["teranggo"],
            "CFBundleURLName": "com.darboedev.terango"
          }
        ],
        "LSApplicationQueriesSchemes": ["wave", "teranggo", "https"]
      }
    },
    "splash": {
      "image": "./assets/App-Icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B00"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/App-Icon.png",
        "backgroundColor": "#FF6B00"
      },
      "splash": {
        "image": "./assets/App-Icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FF6B00"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.darboedev.terango",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "monkfish-app-korrv.ondigitalocean.app",
              "pathPrefix": "/payment-success"
            },

            {
              "scheme": "https",
              "host": "monkfish-app-korrv.ondigitalocean.app",
              "pathPrefix": "api/redirect/payment-success"
            },
            {
              "scheme": "https",
              "host": "monkfish-app-korrv.ondigitalocean.app",
              "pathPrefix": "api/redirect/payment-cancel"
            },

            {
              "scheme": "https",
              "host": "monkfish-app-korrv.ondigitalocean.app",
              "pathPrefix": "/payment-cancel"
            },
            {
              "scheme": "https",
              "host": "terango.gm",
              "pathPrefix": "/payment-success"
            },
            {
              "scheme": "https",
              "host": "terango.gm",
              "pathPrefix": "/payment-cancel"
            },
            {
              "scheme": "teranggo"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.QUERY_ALL_PACKAGES"
      ],
      "queries": {
        "schemes": ["wave", "https", "teranggo"],
        "packages": ["com.wave.personal"]
      },
      "privacyPolicy": "https://terango.gm/privacy-policy.html"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TeranGo to use your location to find nearby vendors and provide accurate delivery estimates."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/App-Icon.png",
          "color": "#FF6B00",
          "sounds": ["./assets/sounds/notification.mp3"]
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "507d12d6-9a8c-4115-a413-86c6c9901d3d"
      }
    }
  }
}

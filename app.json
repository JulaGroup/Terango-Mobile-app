{
  "expo": {
    "name": "TeranGo",
    "slug": "terango",
    "version": "1.0.2",
    "orientation": "portrait",
    "backgroundColor": "#ffffff",
    "icon": "./assets/App-Icon.jpg",
    "userInterfaceStyle": "light",
    "scheme": ["teranggo"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darboedev.terango"
    },
    "splash": {
      "image": "./assets/images/splash-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/App-Icon.jpg",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/images/splash-icon.jpg",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.darboedev.terango",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "privacyPolicy": "https://terango.gm/privacy-policy.html"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TeranGo to use your location to find nearby vendors and provide accurate delivery estimates."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/splash.png",
          "color": "#FF6B35",
          "sounds": ["./assets/sounds/notification.mp3"]
        }
      ],

      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "507d12d6-9a8c-4115-a413-86c6c9901d3d"
      }
    }
  }
}

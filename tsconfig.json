{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx", // or react-jsxdev if dev mode
    "module": "ESNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "app/custom-delivery/index-fixed.tsx",
    "app/order-tracking.web.tsx",
    "components/express/ExpressLocationPicker.tsx",
    "components/express/ModernLocationPicker.tsx",
    "components/OrderManagementHub.tsx"
  ]
}
